<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Secretaría - Hospital Esperanza</title>
</head>
<body style="font-family: Arial, sans-serif; margin: 40px; background-color: #f0f4f8;">

    <div style="background: white; padding: 25px; border-radius: 8px; max-width: 500px; margin: auto; text-align: center; box-shadow: 0 0 10px rgba(0,0,0,0.1);">
        <h2 style="color: #004b87;">Atención en Secretaría</h2>
        <p style="font-size: 18px;">¿Desea agendar una consulta médica?</p>

        <div id="opciones-iniciales">
            <button onclick="mostrarFormulario(true)" style="background-color: #28a745; color: white; border: none; padding: 10px 20px; font-size: 16px; border-radius: 5px; cursor: pointer;">Sí</button>
            <button onclick="mostrarFormulario(false)" style="background-color: #dc3545; color: white; border: none; padding: 10px 20px; font-size: 16px; border-radius: 5px; cursor: pointer; margin-left: 10px;">No</button>
        </div>

        <!-- Opción NO -->
        <div id="mensaje-no" style="display: none; margin-top: 20px;">
            <p style="color: #666;">Entendido. Gracias por visitar el Hospital Esperanza.</p>
            <a href="/" style="background-color: #004b87; color: white; text-decoration: none; padding: 10px 20px; border-radius: 5px; display: inline-block; margin-top: 10px;">Regresar al Inicio</a>
        </div>

        <!-- Opción SÍ: Formulario de Registro -->
        <div id="form-cita" style="display: none; margin-top: 20px; text-align: left; border-top: 1px solid #ccc; padding-top: 15px;">
            <h3 style="text-align: center; color: #004b87;">Datos del Paciente</h3>
            <form action="/registrar_cita" method="POST">
                <label><strong>Nombre completo del paciente:</strong></label><br>
                <input type="text" name="nombre" required style="width: 95%; padding: 8px; margin: 8px 0; font-size: 14px;"><br>

                <label><strong>Edad:</strong></label><br>
                <input type="number" id="edad" name="edad" min="0" max="120" required oninput="verificarTutor()" style="width: 95%; padding: 8px; margin: 8px 0; font-size: 14px;"><br>

                <label><strong>Género:</strong></label><br>
                <select name="genero" required style="width: 100%; padding: 8px; margin: 8px 0; font-size: 14px;">
                    <option value="">Seleccione una opción</option>
                    <option value="Masculino">Masculino</option>
                    <option value="Femenino">Femenino</option>
                </select><br><br>

                <!-- Campos opcionales para tutor de menor de edad -->
                <div id="seccion-tutor" style="display: none; background-color: #fff3cd; border: 1px solid #ffeba1; padding: 12px; border-radius: 5px; margin-bottom: 15px;">
                    <p style="margin: 0 0 10px 0; color: #856404; font-weight: bold;">Paciente menor de edad (requiere tutor):</p>
                    
                    <label>Nombre del tutor presente:</label><br>
                    <input type="text" id="nombre_tutor" name="nombre_tutor" style="width: 95%; padding: 6px; margin: 5px 0;"><br>

                    <label>Edad del tutor:</label><br>
                    <input type="number" id="edad_tutor" name="edad_tutor" min="18" style="width: 95%; padding: 6px; margin: 5px 0;"><br>
                </div>

                <div style="text-align: center;">
                    <button type="submit" style="background-color: #28a745; color: white; border: none; padding: 10px 20px; font-size: 16px; border-radius: 5px; cursor: pointer;">Agendar Cita</button>
                    <a href="/" style="margin-left: 10px; color: #666; text-decoration: none;">Cancelar</a>
                </div>
            </form>
        </div>
    </div>

    <script>
        function mostrarFormulario(deseaAgendar) {
            document.getElementById('opciones-iniciales').style.display = 'none';
            if (deseaAgendar) {
                document.getElementById('form-cita').style.display = 'block';
            } else {
                document.getElementById('mensaje-no').style.display = 'block';
            }
        }

        function verificarTutor() {
            const edad = parseInt(document.getElementById('edad').value);
            const seccionTutor = document.getElementById('seccion-tutor');
            const inputNombreTutor = document.getElementById('nombre_tutor');
            const inputEdadTutor = document.getElementById('edad_tutor');

            if (!isNaN(edad) && edad < 18) {
                seccionTutor.style.display = 'block';
                inputNombreTutor.required = true;
                inputEdadTutor.required = true;
            } else {
                seccionTutor.style.display = 'none';
                inputNombreTutor.required = false;
                inputEdadTutor.required = false;
            }
        }
    </script>

</body>
</html>